# Copy to .env and fill in to turn on emailed bills (FR10). Everything else works without it.
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=<your gmail>,
# SMTP_PASSWORD=<16-character app password from https://myaccount.google.com/apppasswords>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Shared secret between the order and book services. Change it outside a demo.
SERVICE_KEY=dev-service-key-change-me
